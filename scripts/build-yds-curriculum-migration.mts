/**
 * Writes the YDS Kelime + Dil bilgisi curriculum (lib/yds-curriculum.ts) as an idempotent SQL data
 * migration, so production receives it through `prisma migrate deploy` on the next deploy.
 *   npx tsx scripts/build-yds-curriculum-migration.mts <migration-dir>
 */
import { mkdirSync, writeFileSync } from "node:fs";
import { buildYdsGrammarTopics, buildYdsVocabularyTopics, YDS_TOPIC_ORDER, YDS_TOPIC_RENAMES } from "../lib/yds-curriculum";

const dir = process.argv[2];
if (!dir) throw new Error("usage: build-yds-curriculum-migration.mts <migration-dir>");
const TAG = "$" + "ydsc" + "$";
const q = (s: string | null) => {
  if (s === null) return "NULL";
  if (s.includes(TAG)) throw new Error("text contains the quote tag");
  return `${TAG}${s}${TAG}`;
};
const n = (v: number | null) => (v === null ? "NULL" : String(v));
const YDS = `(SELECT id FROM "exam_types" WHERE "code" = 'YDS')`;
const topicId = (slug: string) => `(SELECT id FROM "exam_topics" WHERE "examTypeId" = ${YDS} AND "slug" = ${q(slug)})`;

const out: string[] = [
  "-- Data migration: YDS Kelime topics (core verbs/nouns/adjectives/adverbs + past-exam word list) and the\n" +
    "-- Dil bilgisi sequence. Generated by scripts/build-yds-curriculum-migration.mts from lib/yds-curriculum.ts.\n" +
    "-- Idempotent and YDS-only: topics upsert on (examTypeId, slug); lessons update by (topic, position) or are\n" +
    "-- inserted when missing; nothing is deleted. No-op when the YDS exam type does not exist.",
];
for (const def of [...buildYdsVocabularyTopics(), ...buildYdsGrammarTopics()]) {
  const order = YDS_TOPIC_ORDER.indexOf(def.slug);
  out.push(
    `INSERT INTO "exam_topics" ("id", "examTypeId", "name", "slug", "questionCount", "difficulty", "displayOrder", "createdAt", "updatedAt")\n` +
      `SELECT gen_random_uuid()::text, id, ${q(def.name)}, ${q(def.slug)}, ${n(def.questionCount)}, ${q(def.difficulty)}, ${order}, now(), now() FROM "exam_types" WHERE "code" = 'YDS'\n` +
      `ON CONFLICT ("examTypeId", "slug") DO UPDATE SET "name" = EXCLUDED."name", "questionCount" = EXCLUDED."questionCount", "difficulty" = EXCLUDED."difficulty", "displayOrder" = EXCLUDED."displayOrder", "updatedAt" = now();`,
  );
  def.lessons.forEach((l, position) => {
    out.push(
      `UPDATE "topic_lessons" SET "title" = ${q(l.title)}, "durationMinutes" = ${l.durationMinutes}, "contentBody" = ${q(l.contentBody)}, "contentBodyEn" = NULL, "updatedAt" = now()\n` +
        `WHERE "topicId" = ${topicId(def.slug)} AND "position" = ${position};`,
      `INSERT INTO "topic_lessons" ("id", "topicId", "title", "position", "durationMinutes", "contentBody", "createdAt", "updatedAt")\n` +
        `SELECT gen_random_uuid()::text, t.id, ${q(l.title)}, ${position}, ${l.durationMinutes}, ${q(l.contentBody)}, now(), now() FROM "exam_topics" t\n` +
        `WHERE t.id = ${topicId(def.slug)} AND NOT EXISTS (SELECT 1 FROM "topic_lessons" x WHERE x."topicId" = t.id AND x."position" = ${position});`,
    );
  });
}
for (const [slug, name] of Object.entries(YDS_TOPIC_RENAMES)) {
  out.push(`UPDATE "exam_topics" SET "name" = ${q(name)}, "updatedAt" = now() WHERE "examTypeId" = ${YDS} AND "slug" = ${q(slug)};`);
}
YDS_TOPIC_ORDER.forEach((slug, i) => out.push(`UPDATE "exam_topics" SET "displayOrder" = ${i} WHERE "examTypeId" = ${YDS} AND "slug" = ${q(slug)};`));
mkdirSync(dir, { recursive: true });
writeFileSync(`${dir}/migration.sql`, out.join("\n\n") + "\n");
console.log(`wrote ${out.length} statements to ${dir}/migration.sql`);
